# Normalize to LF in the repository; check out native on Windows.
* text=auto

*.py    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.lock  text eol=lf
*.ps1   text eol=crlf
*.sh    text eol=lf

*.pt    binary
*.pth   binary
*.npz   binary
*.npy   binary
